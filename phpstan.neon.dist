includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    phpVersion: 80200
    level: 8
    scanFiles:
        - ./vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - ./phpstan.php
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - .git
            - .github
            # - .githooks
            - phpstan.php
            - languages
            # - node_modules
            - vendor
            # Test bootstraps + the WordPress integration suite rely on the WP
            # test library, which is not available to static analysis.
            - tests/bootstrap-unit.php
            - tests/bootstrap.php
            - tests/wp
            # examples/ are reference snippets to copy into app/ and adapt.
            - examples
        analyse:
            # Scanned for its symbols (so the unit tests resolve) but not analysed:
            # a fixture that defines init() would otherwise make the Singleton
            # trait's method_exists() guard look "always true". The plain fixture
            # (no init) stays analysed so the trait has a non-narrowed user.
            - tests/unit/fixtures/class-singleton-fixture.php
#    ignoreErrors:
#        - "#^Unsafe access to private property [a-zA-Z0-9\\_\\\\]+::\\$inst through static::.$#"
#        - '#no value type specified in iterable type array.$#'
#        - "#^Offset '[a-zA-Z0-9\\_]+' does not exist on array$#"
#        - "#^Cannot access property \\$[a-zA-Z0-9\\_]+ on stdClass\\|false$#"
