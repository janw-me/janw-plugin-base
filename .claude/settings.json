{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(composer *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(wp *)",
      "Bash(php --version)",
      "Bash(echo \"exit: $?\")"
    ],
    "deny": [
      "Bash(bash .github/ci.sh*)",
      "Bash(php vendor/bin/*)",
      "Bash(vendor/bin/*)",
      "Bash(php -l:*)",
      "Bash(wp @live *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-php.sh"
          }
        ]
      }
    ]
  }
}
